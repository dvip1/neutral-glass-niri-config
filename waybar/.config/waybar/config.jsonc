{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,
  "margin-bottom": 4,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "modules-left": ["niri/workspaces", "group/media"],
  "modules-center": ["clock"],
  "modules-right": ["group/status", "tray"],

  "niri/workspaces": {
  "format": "{icon}",
  "format-icons": { "active": "●", "default": "○" }
},
"niri/window": {
    "format": "{title}",
    "max-length": 45,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Zen Browser": "󰈹  $1",
      "(.*) - nv(.*)": "  nvim $2"
    }
  },
  "clock": {
    "format": "<span alpha='36000'>{0:%a %d %b}</span>   {0:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "pulseaudio": {
    "format": "{icon}", "tooltip-format": "Volume {volume}%  ·  {desc}", "format-icons": {"default": ["<span size='large'></span>","<span size='large'></span>","<span size='large'></span>"]},
    "format-muted": "<span size='large'></span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "bluetooth": {
    "format": "<span size='large'>\uf294</span>",
    "format-on": "<span size='large'>\uf294</span>",
    "format-off": "<span size='large'>\uf294</span>",
    "format-disabled": "<span size='large'>\uf294</span>",
    "format-connected": "<span size='large'>\uf294</span>",
    "format-connected-battery": "<span size='large'>\uf294</span>",
    "tooltip-format": "{controller_alias}  ({status})",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
    "on-click": "$HOME/.local/bin/bt-menu",
    "max-length": 24
  },
  "network": {
    "format-wifi": "<span size='large'></span>",
    "format-ethernet": "<span size='large'></span>",
    "format-disconnected": "<span size='large'></span>",
    "tooltip-format": "{ifname}  {ipaddr}\n{essid}  {signalStrength}%",
    "on-click": "$HOME/.local/bin/wifi-menu"
  },
  "battery": {
    "format": "{icon} {capacity}%", "format-icons": ["<span size='large'></span>","<span size='large'></span>","<span size='large'></span>","<span size='large'></span>","<span size='large'></span>"],
    "format-charging": "<span size='large'></span> {capacity}%",
    "states": { "warning": 25, "critical": 10 }
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "\uf0f3<sup>\uf111</sup>",
      "none": "\uf0f3",
      "dnd-notification": "\uf1f6<sup>\uf111</sup>",
      "dnd-none": "\uf1f6"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "group/media": {
    "orientation": "horizontal",
    "modules": ["image#media-art", "group/media-ctl", "custom/media-viz"]
  },
  "group/media-ctl": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "transition-left-to-right": true, "children-class": "media-ctl" },
    "modules": ["mpris", "custom/media-prev", "custom/media-toggle", "custom/media-next"]
  },
  "group/status": {
    "orientation": "horizontal",
    "modules": ["custom/notification", "pulseaudio", "bluetooth", "network", "battery"]
  },
  "image#media-art": {
    "exec": "$HOME/.local/bin/media art",
    "size": 22,
    "interval": 2,
    "on-click": "playerctl play-pause"
  },
  "mpris": {
    "format": "{title}",
    "title-len": 26,
    "tooltip": false,
    "on-click": "$HOME/.local/bin/nowplaying",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-"
  },
  "custom/media-viz": {
    "exec": "$HOME/.local/bin/media-viz 12",
    "format": "{}",
    "tooltip": false,
    "on-click": "playerctl play-pause"
  },
  "custom/media-prev": {
    "exec": "$HOME/.local/bin/media button prev",
    "on-click": "playerctl previous",
    "tooltip": false
  },
  "custom/media-toggle": {
    "exec": "$HOME/.local/bin/media button toggle",
    "on-click": "playerctl play-pause",
    "tooltip": false
  },
  "custom/media-next": {
    "exec": "$HOME/.local/bin/media button next",
    "on-click": "playerctl next",
    "tooltip": false
  },
  "tray": { "spacing": 8 }
}
