// Quickshell desktop bar (replaces waybar). Start: `qs` (niri spawn-at-startup).
// Colours, fonts, radii and timings come from Theme.qml, generated by `theme apply`.
//   qs ipc call bar toggle     show / hide the bar (Mod+W)
import QtQuick
import Quickshell
import Quickshell.Io

ShellRoot {
    id: root
    property bool barVisible: true

    Variants {
        model: Quickshell.screens
        Bar {
            visible: root.barVisible
        }
    }

    // theme toggles rewrite Theme.qml and reload the bar: only show the popup when a reload fails
    Connections {
        target: Quickshell
        function onReloadCompleted() { Quickshell.inhibitReloadPopup() }
    }

    IpcHandler {
        target: "bar"
        function toggle(): void { root.barVisible = !root.barVisible }
    }
}
