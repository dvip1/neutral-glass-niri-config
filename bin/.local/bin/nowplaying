#!/usr/bin/env python3
"""nowplaying - a glass sheet under the bar's media pill with one card per media player.

Each card has its own prev / play / next and a seek bar. Clicking a card (or Enter on it)
hands the bar to that player (playerctld's active player). Run it again to close it;
it also closes on Esc, when the pointer leaves it, or when focus moves elsewhere.

Colours/fonts come from ~/.config/theme/out/nowplaying.css (generated by `theme apply`).
    nowplaying          toggle the popup
    nowplaying --list   print the players it would show, then exit
    NOWPLAYING_DEBUG=1  log pointer/focus events that close it
"""
import hashlib
import os
import sys
import threading
import urllib.parse
import urllib.request

LAYER_SHELL = 'libgtk4-layer-shell.so.0'
# gtk4-layer-shell must be loaded before libwayland-client, which only LD_PRELOAD guarantees
if LAYER_SHELL not in os.environ.get('LD_PRELOAD', '') and '--list' not in sys.argv:
    os.environ['LD_PRELOAD'] = LAYER_SHELL
    os.execv(sys.executable, [sys.executable, '-I'] + sys.argv)

import gi  # noqa: E402
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('GdkPixbuf', '2.0')
gi.require_version('Gtk4LayerShell', '1.0')
gi.require_version('Pango', '1.0')
gi.require_version('Playerctl', '2.0')
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Gtk4LayerShell as LayerShell, Pango, Playerctl  # noqa: E402

CSS = os.path.expanduser('~/.config/theme/out/nowplaying.css')
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache')), 'nowplaying')
WIDTH = 360
ART = 64              # cover size in logical px (loaded at 2x for HiDPI)
DEAL_STEP_MS = 45     # stagger between cards sliding out on open
LEAVE_GRACE_MS = 350  # pointer may leave briefly (e.g. overshoot) without closing

ICONS = {'spotify': '󰓇', 'firefox': '󰈹', 'chromium': '', 'chrome': '', 'brave': '',
         'mpv': '', 'vlc': '󰕼'}
NAMES = {'mpv': 'mpv', 'vlc': 'VLC'}

PLAYERCTLD = 'org.mpris.MediaPlayer2.playerctld'
PLAYERCTLD_IFACE = 'com.github.altdesktop.playerctld'
MPRIS_PREFIX = 'org.mpris.MediaPlayer2.'


def debug(*a):
    if os.environ.get('NOWPLAYING_DEBUG'):
        print(*a, file=sys.stderr, flush=True)


def player_icon(name):
    return ICONS.get(name, '󰝚')


def player_label(name):
    return NAMES.get(name, name.capitalize())


def fmt_time(us):
    s = max(0, int(us // 1_000_000))
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f'{h}:{m:02}:{s:02}' if h else f'{m}:{s:02}'


def bar_x():
    """Logical x of the media pill: it sits right after the workspace dots on the bar."""
    try:
        import json
        import subprocess
        out = json.loads(subprocess.run(['niri', 'msg', '--json', 'focused-output'],
                                        capture_output=True, text=True).stdout)
        ws = json.loads(subprocess.run(['niri', 'msg', '--json', 'workspaces'],
                                       capture_output=True, text=True).stdout)
        n = sum(1 for w in ws if w['output'] == out['name'])
    except Exception:
        n = 4
    # the bar can't report where a module is, so this follows its layout (Quickshell Bar.qml /
    # Workspaces.qml, keep in sync): 10 px bar margin + 8 px in + 16 px gap to the media pill;
    # per workspace a dot 8 + 2*3 padding, and the active pill is 32 instead of 8
    return 34 + (8 + 2 * 3) * n + (32 - 8)


# ---------- active player (playerctld) ----------
class Active:
    """playerctld's player order; the first is what the bar's buttons control."""

    def __init__(self, on_change):
        self.on_change = on_change
        try:
            self.proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
                PLAYERCTLD, '/org/mpris/MediaPlayer2', PLAYERCTLD_IFACE, None)
            self.proxy.connect('g-properties-changed', lambda *a: self.on_change())
        except GLib.Error:
            self.proxy = None

    def order(self):
        v = self.proxy.get_cached_property('PlayerNames') if self.proxy else None
        return [n[len(MPRIS_PREFIX):] for n in v.unpack()] if v else []

    def first(self):
        o = self.order()
        return o[0] if o else None

    def make_active(self, instance):
        o = self.order()
        if instance not in o or o[0] == instance:
            return
        i = o.index(instance)
        # Shift rotates the front to the back, Unshift the back to the front: take the shorter way
        method, times = ('Shift', i) if i <= len(o) - i else ('Unshift', len(o) - i)
        for _ in range(times):
            self.proxy.call_sync(method, None, Gio.DBusCallFlags.NONE, 1000, None)


# ---------- album art ----------
def art_path(url, done):
    """Resolve an mpris:artUrl to a local file, downloading in a thread. Calls done(path|None) on the main loop."""
    if not url:
        return done(None)
    if url.startswith('file://'):
        return done(urllib.parse.unquote(urllib.parse.urlparse(url).path))
    if not url.startswith(('http://', 'https://')):
        return done(None)
    os.makedirs(CACHE, exist_ok=True)
    out = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest()[:16])
    if os.path.exists(out) and os.path.getsize(out):
        return done(out)

    def fetch():
        try:
            tmp = out + '.part'
            with urllib.request.urlopen(url, timeout=5) as r, open(tmp, 'wb') as f:
                f.write(r.read())
            os.replace(tmp, out)
            files = sorted((os.path.join(CACHE, f) for f in os.listdir(CACHE)), key=os.path.getmtime)
            for old in files[:-40]:
                os.remove(old)
            GLib.idle_add(done, out)
        except Exception:
            GLib.idle_add(done, None)
    threading.Thread(target=fetch, daemon=True).start()


def cover_texture(path):
    """Centre-crop to a square and scale to 2x the cover size."""
    pb = GdkPixbuf.Pixbuf.new_from_file(path)
    side = min(pb.get_width(), pb.get_height())
    pb = pb.new_subpixbuf((pb.get_width() - side) // 2, (pb.get_height() - side) // 2, side, side)
    pb = pb.scale_simple(ART * 2, ART * 2, GdkPixbuf.InterpType.HYPER)
    ok, png = pb.save_to_bufferv('png', [], [])
    return Gdk.Texture.new_from_bytes(GLib.Bytes.new(png))


# ---------- one card ----------
class Card(Gtk.Box):
    def __init__(self, player, on_pick):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.player = player
        self.on_pick = on_pick
        self.art_url = None
        self.length = 0
        self.seeking = False
        self.add_css_class('card')
        self.add_css_class('dealing')
        self.set_focusable(True)
        self.set_cursor_from_name('pointer')

        name = player.props.player_name
        top = Gtk.Box(spacing=12)
        self.append(top)

        # art: cover image, or the player's icon on a tile when there is none
        self.art = Gtk.Stack()
        self.art.add_css_class('art')
        self.art.set_overflow(Gtk.Overflow.HIDDEN)
        self.art.set_size_request(ART, ART)
        self.art.set_valign(Gtk.Align.START)
        self.picture = Gtk.Image(pixel_size=ART)
        fallback = Gtk.Label(label=player_icon(name))
        fallback.add_css_class('art-icon')
        self.art.add_named(fallback, 'icon')
        self.art.add_named(self.picture, 'cover')
        top.append(self.art)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        top.append(text)
        self.title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, hexpand=True)
        self.title.add_css_class('title')
        self.artist = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)
        self.artist.add_css_class('artist')
        text.append(self.title)
        text.append(self.artist)

        row = Gtk.Box(spacing=2)
        row.add_css_class('row')
        text.append(row)
        source = Gtk.Label(label=f'{player_icon(name)}  {player_label(name)}', xalign=0, hexpand=True)
        source.add_css_class('source')
        row.append(source)
        self.prev = self.button('󰒮', 'Previous', lambda: player.previous())
        self.toggle = self.button('󰐊', 'Play', lambda: player.play_pause())
        self.next = self.button('󰒭', 'Next', lambda: player.next())
        for b in (self.prev, self.toggle, self.next):
            row.append(b)

        # seek bar, only for players that report a length
        self.seek = Gtk.Box(spacing=8)
        self.seek.add_css_class('seek')
        self.pos_label = Gtk.Label(xalign=0)
        self.len_label = Gtk.Label(xalign=1)
        for l in (self.pos_label, self.len_label):
            l.add_css_class('time')
        self.scale = Gtk.Scale(hexpand=True, draw_value=False)
        self.scale.connect('change-value', self.on_seek)
        drag = Gtk.GestureClick()
        drag.connect('pressed', lambda *a: setattr(self, 'seeking', True))
        drag.connect('released', lambda *a: setattr(self, 'seeking', False))
        drag.connect('stopped', lambda *a: setattr(self, 'seeking', False))
        self.scale.add_controller(drag)
        self.seek.append(self.pos_label)
        self.seek.append(self.scale)
        self.seek.append(self.len_label)
        self.append(self.seek)

        click = Gtk.GestureClick()
        click.connect('released', lambda *a: self.on_pick(self))
        self.add_controller(click)
        keys = Gtk.EventControllerKey()
        keys.connect('key-pressed', self.on_key)
        self.add_controller(keys)

        player.connect('metadata', lambda *a: self.refresh())
        player.connect('playback-status', lambda *a: self.refresh())
        player.connect('seeked', lambda *a: self.tick())
        self.refresh()

    def button(self, icon, tip, action):
        b = Gtk.Button(label=icon)
        b.add_css_class('ctl')
        b.set_cursor_from_name('pointer')
        b.update_property([Gtk.AccessibleProperty.LABEL], [tip])
        b.connect('clicked', lambda *_: self.safe(action))
        return b

    @staticmethod
    def safe(action):
        try:
            action()
        except GLib.Error:
            pass  # the player went away or refused; the card updates/vanishes on its own

    @property
    def instance(self):
        return self.player.props.player_instance

    def meta(self, key):
        try:
            return self.player.print_metadata_prop(key) or ''
        except GLib.Error:
            return ''

    def refresh(self):
        p = self.player
        title = self.meta('xesam:title') or player_label(p.props.player_name)
        artist = self.meta('xesam:artist')
        self.title.set_label(title)
        self.artist.set_label(artist)
        self.artist.set_visible(bool(artist))

        playing = p.props.playback_status == Playerctl.PlaybackStatus.PLAYING
        self.toggle.set_label('󰏤' if playing else '󰐊')
        self.toggle.update_property([Gtk.AccessibleProperty.LABEL], ['Pause' if playing else 'Play'])
        self.set_css_classes([c for c in self.get_css_classes() if c != 'paused'] + ([] if playing else ['paused']))
        self.prev.set_sensitive(p.props.can_go_previous)
        self.next.set_sensitive(p.props.can_go_next)
        self.toggle.set_sensitive(p.props.can_play or p.props.can_pause)

        try:
            self.length = int(self.meta('mpris:length') or 0)
        except ValueError:
            self.length = 0
        self.seek.set_visible(self.length > 0)
        self.scale.set_sensitive(p.props.can_seek)
        if self.length:
            self.scale.set_range(0, self.length / 1e6)
            self.len_label.set_label(fmt_time(self.length))
        self.tick()

        url = self.meta('mpris:artUrl')
        if url != self.art_url:
            self.art_url = url
            art_path(url, self.set_art)

    def set_art(self, path):
        try:
            self.picture.set_from_paintable(cover_texture(path) if path else None)
            self.art.set_visible_child_name('cover' if path else 'icon')
        except GLib.Error:
            self.art.set_visible_child_name('icon')
        return False

    def tick(self):
        if not self.length or self.seeking:
            return
        try:
            pos = self.player.get_position()
        except GLib.Error:
            return
        self.scale.set_value(pos / 1e6)
        self.pos_label.set_label(fmt_time(pos))

    def on_seek(self, _scale, _scroll, value):
        value = max(0.0, min(value, self.length / 1e6))
        self.pos_label.set_label(fmt_time(value * 1e6))
        self.safe(lambda: self.player.set_position(int(value * 1e6)))
        return False

    def on_key(self, _ctl, keyval, _code, _state):
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.on_pick(self)
        elif keyval == Gdk.KEY_space:
            self.safe(self.player.play_pause)
        elif keyval == Gdk.KEY_Left:
            self.safe(self.player.previous)
        elif keyval == Gdk.KEY_Right:
            self.safe(self.player.next)
        else:
            return False
        return True


# ---------- the sheet ----------
class Popup(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='Now playing')
        self.add_css_class('nowplaying')
        self.cards = {}
        self.entered = False
        self.was_active = False
        self.leave_timer = 0
        self.closing = False

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, 'nowplaying')
        LayerShell.set_layer(self, LayerShell.Layer.TOP)
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self, LayerShell.Edge.LEFT, True)
        LayerShell.set_margin(self, LayerShell.Edge.TOP, 6)
        LayerShell.set_margin(self, LayerShell.Edge.LEFT, bar_x())
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.add_css_class('panel')
        self.box.set_size_request(WIDTH, -1)
        self.set_child(self.box)

        self.active = Active(self.mark_active)
        self.manager = Playerctl.PlayerManager()
        self.manager.connect('name-appeared', lambda _m, n: self.add_player(n))
        self.manager.connect('player-vanished', lambda _m, p: self.remove_player(p))
        # stack order: the bar's player on top, then most recently active first
        order = self.active.order()
        names = sorted(self.manager.props.player_names,
                       key=lambda n: order.index(n.instance) if n.instance in order else len(order))
        for n in names:
            self.add_player(n)

        motion = Gtk.EventControllerMotion()
        motion.connect('enter', self.on_enter)
        motion.connect('leave', self.on_leave)
        self.add_controller(motion)
        keys = Gtk.EventControllerKey()
        keys.connect('key-pressed', lambda _c, k, *_: k == Gdk.KEY_Escape and (self.dismiss() or True))
        self.add_controller(keys)
        self.connect('notify::is-active', self.on_active_changed)
        GLib.timeout_add(500, self.tick)
        self.mark_active()

    def add_player(self, name):
        if name.instance in self.cards:
            return
        player = Playerctl.Player.new_from_name(name)
        self.manager.manage_player(player)
        card = Card(player, self.pick)
        self.cards[name.instance] = card
        self.box.append(card)
        if self.get_mapped():
            GLib.timeout_add(16, self.deal, card)
        self.mark_active()

    def remove_player(self, player):
        card = self.cards.pop(player.props.player_instance, None)
        if card:
            self.box.remove(card)
        if not self.cards:
            self.dismiss()

    def deal(self, card):
        card.remove_css_class('dealing')
        return False

    def deal_all(self):
        for i, card in enumerate(self.cards.values()):
            GLib.timeout_add(16 + DEAL_STEP_MS * i, self.deal, card)

    def pick(self, card):
        card.grab_focus()
        try:
            self.active.make_active(card.instance)
        except GLib.Error:
            pass

    def mark_active(self):
        first = self.active.first() or next(iter(self.cards), None)
        for inst, card in self.cards.items():
            (card.add_css_class if inst == first else card.remove_css_class)('active')

    def tick(self):
        for card in self.cards.values():
            card.tick()
        return True

    def on_enter(self, *_):
        debug('enter')
        self.entered = True
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
            self.leave_timer = 0

    def on_leave(self, *_):
        debug('leave')
        if self.entered and not self.leave_timer:
            self.leave_timer = GLib.timeout_add(LEAVE_GRACE_MS, self.dismiss)

    def on_active_changed(self, *_):
        debug('active', self.is_active())
        if self.is_active():
            self.was_active = True
        elif self.was_active:
            self.dismiss()

    def dismiss(self):
        # several triggers can fire together (toggle + focus loss); close only once
        if not self.closing:
            self.closing = True
            self.close()
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='io.github.dvip1.nowplaying')
        self.popup = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        try:
            provider.load_from_path(CSS)
        except GLib.Error:
            pass
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def do_activate(self):
        # a second launch lands here in the running instance: toggle closed
        if self.popup:
            self.popup.dismiss()
            return
        self.popup = Popup(self)
        if not self.popup.cards:
            self.popup.dismiss()
            return
        self.popup.connect('close-request', lambda *_: self.quit() or False)
        self.popup.present()
        self.popup.deal_all()


def main():
    if '--list' in sys.argv:
        for n in Playerctl.PlayerManager().props.player_names:
            p = Playerctl.Player.new_from_name(n)
            print(f'{n.instance}\t{p.props.playback_status.value_nick}\t{p.get_title() or ""}')
        return 0
    return App().run([sys.argv[0]])


if __name__ == '__main__':
    sys.exit(main())
