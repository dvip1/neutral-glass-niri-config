#!/usr/bin/env bash
# Waybar audio visualizer: cava raw output -> ▁▂▃▄▅▆ bars (capped below full height so it stays quiet), one line per frame.
# Prints an empty line after ~1.5 s of silence so the module hides itself.
#   media-viz [bars]   (default 10)
set -u

bars=${1:-10}
conf="${XDG_RUNTIME_DIR:-/tmp}/waybar-cava.conf"

cat > "$conf" <<EOF
[general]
bars = $bars
framerate = 30
autosens = 1

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 5
bar_delimiter = 59
frame_delimiter = 10
channels = mono
mono_option = average

[smoothing]
noise_reduction = 70
monstercat = 1
EOF

# stop cava when waybar goes away
trap 'kill 0' EXIT

cava -p "$conf" | awk -F';' -v silence=45 '
BEGIN { split("▁ ▂ ▃ ▄ ▅ ▆", g, " "); quiet = silence }
{
    s = ""; loud = 0
    for (i = 1; i <= NF; i++) {
        if ($i == "") continue
        s = s g[$i + 1]
        if ($i > 0) loud = 1
    }
    quiet = loud ? 0 : quiet + 1
    if (quiet < silence) { print s; fflush() }
    else if (quiet == silence) { print ""; fflush() }
}'
