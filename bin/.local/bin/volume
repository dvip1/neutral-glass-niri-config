#!/usr/bin/env bash
# Usage: volume up|down|mute   (bound to the XF86Audio* keys in niri)
# Changes the default output with wpctl, up to 150 % (same cap as scrolling on the bar's volume
# icon). The Quickshell OSD pops up by itself whenever the volume or mute changes.
set -euo pipefail

STEP=5
MAX=1.5
SINK=@DEFAULT_AUDIO_SINK@

case "${1:-}" in
  up) wpctl set-mute "$SINK" 0; wpctl set-volume -l "$MAX" "$SINK" "$STEP%+" ;;
  down) wpctl set-volume "$SINK" "$STEP%-" ;;
  mute) wpctl set-mute "$SINK" toggle ;;
  *) echo "usage: volume up|down|mute" >&2; exit 2 ;;
esac
