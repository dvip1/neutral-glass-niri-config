#!/usr/bin/env python3
"""powerpanel - a glass sheet under the bar's battery: charge, power profile, power settings.

Battery state comes from UPower, profiles from power-profiles (tuned-ppd here), both over D-Bus,
and both update live. "Power settings" opens ~/.config/power/power.conf in nvim (power-settings).
Run it again to close it; it also closes on Esc, when the pointer leaves it, or on focus loss.

Colours/fonts come from ~/.config/theme/out/powerpanel.css (generated by `theme apply`).
    powerpanel          toggle the popup
    powerpanel --print  print what it would show, then exit
"""
import glob
import os
import subprocess
import sys

LAYER_SHELL = 'libgtk4-layer-shell.so.0'
# gtk4-layer-shell must be loaded before libwayland-client, which only LD_PRELOAD guarantees
if LAYER_SHELL not in os.environ.get('LD_PRELOAD', '') and '--print' not in sys.argv:
    os.environ['LD_PRELOAD'] = LAYER_SHELL
    os.execv(sys.executable, [sys.executable, '-I'] + sys.argv)

import gi  # noqa: E402
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('Gtk4LayerShell', '1.0')
from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell as LayerShell  # noqa: E402

CSS = os.path.expanduser('~/.config/theme/out/powerpanel.css')
BIN = os.path.expanduser('~/.local/bin')
WIDTH = 320
LEAVE_GRACE_MS = 350  # pointer may leave briefly (e.g. overshoot) without closing

PROFILES = [('power-saver', '󰾆', 'Saver'), ('balanced', '󰾅', 'Balanced'), ('performance', '󰓅', 'Performance')]
BATTERY = '󰁺󰁼󰁾󰂀󰁹'          # same glyphs as the bar (10 / 30 / 50 / 70 / 100 %)
BATTERY_CHARGING = '󰢜󰂇󰢝󰢞󰂅'
# UPower Device.State
CHARGING, DISCHARGING, EMPTY, FULL, PENDING_CHARGE, PENDING_DISCHARGE = range(1, 7)


def system_proxy(name, path, iface):
    return Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                                          name, path, iface, None)


def prop(proxy, name, default=None):
    v = proxy.get_cached_property(name) if proxy else None
    return v.unpack() if v is not None else default


def fmt_duration(secs):
    m = round(secs / 60)
    h, m = divmod(m, 60)
    return f'{h} h {m:02} min' if h else f'{m} min'


def charge_limit_on():
    """IdeaPad conservation mode (charging stops around 80 %); None if this laptop has none."""
    for f in glob.glob('/sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode'):
        try:
            return open(f).read().strip() == '1'
        except OSError:
            pass
    return None


def battery_text(dev):
    pct = prop(dev, 'Percentage', 0.0)
    state = prop(dev, 'State', 0)
    charging = state in (CHARGING, PENDING_CHARGE, FULL)
    icons = BATTERY_CHARGING if charging else BATTERY
    icon = icons[min(4, int(pct // 20))]
    rate = prop(dev, 'EnergyRate', 0.0)
    if state == CHARGING:
        t = prop(dev, 'TimeToFull', 0)
        status = f'Charging · full in {fmt_duration(t)}' if t else 'Charging'
    elif state == DISCHARGING:
        t = prop(dev, 'TimeToEmpty', 0)
        status = f'{fmt_duration(t)} left' if t else 'On battery'
    elif state == FULL:
        status = 'Fully charged'
    elif state == PENDING_CHARGE:
        status = 'Plugged in · not charging'
    else:
        status = 'On battery' if state in (EMPTY, PENDING_DISCHARGE) else 'Unknown'
    detail = []
    if rate > 0.05:
        detail.append(f'{rate:.1f} W')
    limit = charge_limit_on()
    if limit is not None:
        detail.append('charge limit on (~80 %)' if limit else 'charge limit off')
    return icon, f'{pct:.0f}%', status, '  ·  '.join(detail)


def idle_summary():
    """One line from power.conf (via `idle --print`) for the current power source."""
    try:
        out = subprocess.run([os.path.join(BIN, 'idle'), '--print'], capture_output=True,
                             text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''
    cfg, src = {}, 'battery'
    for line in out.splitlines():
        if line.startswith('power source:'):
            src = line.split(':', 1)[1].strip()
        elif ' = ' in line:
            k, v = line.split(' = ', 1)
            cfg[k.strip()] = v.strip()

    def mins(key):
        v = float(cfg.get(f'{src}_{key}') or 0)
        return f'{v:g}m' if v else 'never'
    where = 'On battery' if src == 'battery' else 'Plugged in'
    return f'{where}: lock {mins("lock")} · off {mins("screen_off")} · sleep {mins("suspend")}'


# ---------- the sheet ----------
class Popup(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='Power')
        self.add_css_class('powerpanel')
        self.entered = False
        self.was_active = False
        self.leave_timer = 0
        self.closing = False

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, 'powerpanel')
        LayerShell.set_layer(self, LayerShell.Layer.TOP)
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self, LayerShell.Edge.RIGHT, True)
        LayerShell.set_margin(self, LayerShell.Edge.TOP, 6)
        LayerShell.set_margin(self, LayerShell.Edge.RIGHT, 10)   # the bar's margin-right
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.add_css_class('panel')
        box.set_size_request(WIDTH, -1)
        self.set_child(box)

        # battery: big icon, percentage, status, detail
        head = Gtk.Box(spacing=12)
        head.add_css_class('head')
        self.bat_icon = Gtk.Label(css_classes=['bat-icon'])
        head.append(self.bat_icon)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        top = Gtk.Box(spacing=8)
        self.pct = Gtk.Label(css_classes=['pct'], xalign=0)
        self.status = Gtk.Label(css_classes=['status'], xalign=0, valign=Gtk.Align.BASELINE_CENTER)
        top.append(self.pct)
        top.append(self.status)
        self.detail = Gtk.Label(css_classes=['detail'], xalign=0)
        text.append(top)
        text.append(self.detail)
        head.append(text)
        box.append(head)

        # power profile: one segmented control
        seg = Gtk.Box(homogeneous=True, css_classes=['profiles'])
        self.prof_buttons = {}
        for key, icon, label in PROFILES:
            b = Gtk.Button(css_classes=['profile'], tooltip_text=label)
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            inner.append(Gtk.Label(label=icon, css_classes=['profile-icon']))
            inner.append(Gtk.Label(label=label, css_classes=['profile-name']))
            b.set_child(inner)
            b.connect('clicked', lambda _b, k=key: self.set_profile(k))
            seg.append(b)
            self.prof_buttons[key] = b
        box.append(seg)

        # settings: opens power.conf in nvim
        btn = Gtk.Button(css_classes=['settings'])
        row = Gtk.Box(spacing=10)
        row.append(Gtk.Label(label='󰒓', css_classes=['settings-icon']))
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        col.append(Gtk.Label(label='Power settings', xalign=0, css_classes=['settings-title']))
        self.summary = Gtk.Label(xalign=0, css_classes=['settings-sub'], ellipsize=3)  # 3 = Pango.EllipsizeMode.END
        col.append(self.summary)
        row.append(col)
        row.append(Gtk.Label(label='󰅂', css_classes=['chevron']))
        btn.set_child(row)
        btn.connect('clicked', self.open_settings)
        box.append(btn)

        try:
            self.dev = system_proxy('org.freedesktop.UPower', '/org/freedesktop/UPower/devices/DisplayDevice',
                                    'org.freedesktop.UPower.Device')
            self.dev.connect('g-properties-changed', lambda *_: self.update_battery())
        except GLib.Error:
            self.dev = None
        try:
            self.ppd = system_proxy('net.hadess.PowerProfiles', '/net/hadess/PowerProfiles',
                                    'net.hadess.PowerProfiles')
            self.ppd.connect('g-properties-changed', lambda *_: self.update_profile())
        except GLib.Error:
            self.ppd = None
        self.update_battery()
        self.update_profile()
        self.summary.set_label(idle_summary())

        motion = Gtk.EventControllerMotion()
        motion.connect('enter', self.on_enter)
        motion.connect('leave', self.on_leave)
        self.add_controller(motion)
        keys = Gtk.EventControllerKey()
        keys.connect('key-pressed', lambda _c, k, *_: k == Gdk.KEY_Escape and (self.dismiss() or True))
        self.add_controller(keys)
        self.connect('notify::is-active', self.on_active_changed)

    def update_battery(self):
        icon, pct, status, detail = battery_text(self.dev)
        self.bat_icon.set_label(icon)
        self.pct.set_label(pct)
        self.status.set_label(status)
        self.detail.set_label(detail)
        self.detail.set_visible(bool(detail))

    def update_profile(self):
        active = prop(self.ppd, 'ActiveProfile', '')
        available = {p.get('Profile') for p in prop(self.ppd, 'Profiles', [])}
        for key, b in self.prof_buttons.items():
            (b.add_css_class if key == active else b.remove_css_class)('active')
            b.set_sensitive(key in available)

    def set_profile(self, key):
        if not self.ppd:
            return
        try:
            self.ppd.call_sync('org.freedesktop.DBus.Properties.Set',
                               GLib.Variant('(ssv)', ('net.hadess.PowerProfiles', 'ActiveProfile',
                                                      GLib.Variant('s', key))),
                               Gio.DBusCallFlags.NONE, -1, None)
        except GLib.Error as e:
            print(f'powerpanel: could not set profile: {e.message}', file=sys.stderr)

    def open_settings(self, *_):
        subprocess.Popen([os.path.join(BIN, 'power-settings')], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.dismiss()

    def on_enter(self, *_):
        self.entered = True
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
            self.leave_timer = 0

    def on_leave(self, *_):
        if self.entered and not self.leave_timer:
            self.leave_timer = GLib.timeout_add(LEAVE_GRACE_MS, self.dismiss)

    def on_active_changed(self, *_):
        if self.is_active():
            self.was_active = True
        elif self.was_active:
            self.dismiss()

    def dismiss(self):
        # several triggers can fire together (toggle + focus loss); close only once
        if not self.closing:
            self.closing = True
            self.close()
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='io.github.dvip1.powerpanel')
        self.popup = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        try:
            provider.load_from_path(CSS)
        except GLib.Error:
            pass
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def do_activate(self):
        # a second launch lands here in the running instance: toggle closed
        if self.popup:
            self.popup.dismiss()
            return
        self.popup = Popup(self)
        self.popup.connect('close-request', lambda *_: self.quit() or False)
        self.popup.present()
        # no focus ring on the first button when opened by mouse (Tab still shows it)
        self.popup.set_focus(None)
        self.popup.set_focus_visible(False)


def main():
    if '--print' in sys.argv:
        dev = system_proxy('org.freedesktop.UPower', '/org/freedesktop/UPower/devices/DisplayDevice',
                           'org.freedesktop.UPower.Device')
        ppd = system_proxy('net.hadess.PowerProfiles', '/net/hadess/PowerProfiles', 'net.hadess.PowerProfiles')
        print(*battery_text(dev), sep='\n')
        print('profile:', prop(ppd, 'ActiveProfile'), '| available:',
              ', '.join(p.get('Profile') for p in prop(ppd, 'Profiles', [])))
        print(idle_summary())
        return 0
    return App().run([sys.argv[0]])


if __name__ == '__main__':
    sys.exit(main())
