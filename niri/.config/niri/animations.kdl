// GENERATED by `theme apply` from ~/.config/theme/templates/animations.kdl - edit that, not this file.
// Liquid window animations (included from config.kdl).
//
// A window wells up like a drop of glass: it grows on a soft spring, its content
// starts slightly magnified through a lens that flattens as it settles, and a thin
// light catches its top edge. Closing reverses it: the glass pinches and fades.
// niri only gives these shaders the window itself (not what is behind it).
// The corner radius in the shaders is the theme's `radius`.

animations {
    // Springs: stiff and just under critical damping: quick, with a barely-there settle.
    window-movement {
        spring damping-ratio=0.88 stiffness=1200 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=1200 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=0.9 stiffness=1400 epsilon=0.0001
    }

    // Resize: old content crossfades into the new, through a faint lens that is strongest
    // mid-resize and flat at rest; corners stay rounded the whole time.
    window-resize {
        spring damping-ratio=0.9 stiffness=1200 epsilon=0.0001
        custom-shader r"
            float rs_box(vec2 p, vec2 b, float r) {
                vec2 q = abs(p) - b + vec2(r);
                return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
            }

            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                vec2 half_size = size_curr_geo.xy * 0.5;
                vec2 px = (coords_curr_geo.xy - 0.5) * size_curr_geo.xy;
                float mask = clamp(0.5 - rs_box(px, half_size, 16.0), 0.0, 1.0);
                if (mask <= 0.0)
                    return vec4(0.0);

                float c = niri_clamped_progress;
                float lens = 0.025 * sin(3.14159 * c);
                vec2 d = px / half_size;
                float r2 = clamp(dot(d, d) * 0.5, 0.0, 1.0);
                vec3 uv = vec3(clamp(0.5 + d * 0.5 * (1.0 - lens * (1.0 - r2)), 0.0, 1.0), 1.0);

                vec4 prev = texture2D(niri_tex_prev, (niri_geo_to_tex_prev * uv).st);
                vec4 next = texture2D(niri_tex_next, (niri_geo_to_tex_next * uv).st);
                return mix(prev, next, smoothstep(0.0, 0.6, c)) * mask;
            }
        "
    }

    window-open {
        spring damping-ratio=0.82 stiffness=1000 epsilon=0.0001
        custom-shader r"
            // Signed distance to a rounded rectangle centred at 0 (negative inside).
            float lq_box(vec2 p, vec2 b, float r) {
                vec2 q = abs(p) - b + vec2(r);
                return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
            }

            // scale: window size factor; lens: > 0 magnifies the centre, < 0 pinches it;
            // glint: strength of the edge light; alpha: opacity.
            vec4 lq_glass(vec3 coords_geo, vec3 size_geo, float scale, float lens, float glint, float alpha) {
                vec2 half_size = size_geo.xy * 0.5;
                vec2 px = (coords_geo.xy - 0.5) * size_geo.xy / scale;
                float sdf = lq_box(px, half_size, 16.0);
                float mask = clamp(0.5 - sdf * scale, 0.0, 1.0);
                if (mask <= 0.0)
                    return vec4(0.0);

                // Barrel lens: d is -1..1 across the window, strongest bend in the middle.
                vec2 d = px / half_size;
                float r2 = clamp(dot(d, d) * 0.5, 0.0, 1.0);
                vec2 uv = 0.5 + d * 0.5 * (1.0 - lens * (1.0 - r2));
                uv = clamp(uv, 0.0, 1.0);
                vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);

                // Thin light along the rim, brighter on the top edge, fading towards the bottom.
                float rim = clamp(1.0 + sdf / 1.5, 0.0, 1.0);
                float top = clamp(0.5 - d.y * 0.5, 0.0, 1.0);
                float light = rim * glint * (0.25 + 0.75 * top * top);
                color.rgb = min(color.rgb + light * color.a, vec3(color.a));

                return color * mask * alpha;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_progress;
                float c = niri_clamped_progress;
                float settle = 1.0 - c;
                return lq_glass(coords_geo, size_geo,
                                0.93 + 0.07 * p,
                                0.07 * settle * settle,
                                0.55 * settle,
                                smoothstep(0.0, 0.55, c));
            }
        "
    }

    window-close {
        duration-ms 150
        curve "ease-out-cubic"
        custom-shader r"
            float lq_box(vec2 p, vec2 b, float r) {
                vec2 q = abs(p) - b + vec2(r);
                return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
            }

            vec4 lq_glass(vec3 coords_geo, vec3 size_geo, float scale, float lens, float glint, float alpha) {
                vec2 half_size = size_geo.xy * 0.5;
                vec2 px = (coords_geo.xy - 0.5) * size_geo.xy / scale;
                float sdf = lq_box(px, half_size, 16.0);
                float mask = clamp(0.5 - sdf * scale, 0.0, 1.0);
                if (mask <= 0.0)
                    return vec4(0.0);

                vec2 d = px / half_size;
                float r2 = clamp(dot(d, d) * 0.5, 0.0, 1.0);
                vec2 uv = 0.5 + d * 0.5 * (1.0 - lens * (1.0 - r2));
                uv = clamp(uv, 0.0, 1.0);
                vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);

                float rim = clamp(1.0 + sdf / 1.5, 0.0, 1.0);
                float top = clamp(0.5 - d.y * 0.5, 0.0, 1.0);
                float light = rim * glint * (0.25 + 0.75 * top * top);
                color.rgb = min(color.rgb + light * color.a, vec3(color.a));

                return color * mask * alpha;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float c = niri_clamped_progress;
                return lq_glass(coords_geo, size_geo,
                                1.0 - 0.06 * c,
                                -0.06 * c,
                                0.45 * c * (1.0 - c) * 4.0,
                                1.0 - smoothstep(0.1, 1.0, c));
            }
        "
    }
}
