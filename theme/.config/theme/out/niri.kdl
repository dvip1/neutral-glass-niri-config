// GENERATED by `theme apply` from ~/.config/theme/templates/niri.kdl - edit that or theme.toml, not this file.
// Included from ~/.config/niri/config.kdl (niri reloads by itself when this changes).

layout {
    gaps 12
    focus-ring {
        width 2
        active-color "#ebbcbab2"
        inactive-color "#e0def41a"
    }
}

// Rounded corners for all windows. clip-to-geometry also trims the
// client-drawn shadow (GTK/libadwaita) so the focus ring follows the corners.
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// Frosted-glass kitty: blur behind it (if the theme has blur), and don't paint the ring through its transparency.
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
    draw-border-with-background false
    geometry-corner-radius 16
    clip-to-geometry true
}

// The settings app (niri-settings) is see-through like kitty.
window-rule {
    match app-id="^niri-settings$"
    default-column-width { fixed 980; }
    background-effect {
        blur true
    }
    draw-border-with-background false
}

// Frosted glass for the bar, notifications, launcher and volume popup.
// Radii must match what each app draws, or the blur pokes out of the corners.
layer-rule {
    match namespace="^waybar$"
    background-effect { blur true; }
    geometry-corner-radius 16
}
// The Quickshell bar (square: it spans the top edge). Its tooltips are not blurred: niri would show the blur box at once,
// before the tooltip has faded in (they are nearly opaque anyway).
layer-rule {
    match namespace="^bar$"
    background-effect { blur true; }
}
// Quickshell's date menu (notifications + calendar) and notification popups.
layer-rule {
    match namespace="^datemenu$"
    match namespace="^quicksettings$"
    match namespace="^notification$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 18
}
// Quickshell's polkit prompt: the whole screen behind it is blurred (and dimmed by the prompt).
layer-rule {
    match namespace="^polkit$"
    background-effect {
        blur true
        xray false
    }
}
// Quickshell's volume/brightness OSD: the surface itself grows and shrinks, so the blur follows.
layer-rule {
    match namespace="^osd$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 18
}
layer-rule {
    match namespace="^swaync-control-center$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 16
}
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 18
}
layer-rule {
    match namespace="^nowplaying$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 18
}
layer-rule {
    match namespace="^powerpanel$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 18
}
layer-rule {
    match namespace="^swayosd$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 18
}
