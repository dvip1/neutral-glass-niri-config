// GENERATED by `theme apply` from ~/.config/theme/templates/niri.kdl - edit that or theme.toml, not this file.
// Included from ~/.config/niri/config.kdl (niri reloads by itself when this changes).

layout {
    focus-ring {
        width 2
        active-color "#ffffff66"
        inactive-color "#ffffff1a"
    }
}

// Rounded corners for all windows. clip-to-geometry also trims the
// client-drawn shadow (GTK/libadwaita) so the focus ring follows the corners.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Frosted-glass kitty: blur behind it, and don't paint the ring through its transparency.
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

// Frosted glass for the bar, notifications, launcher and volume popup.
// Radii must match what each app draws, or the blur pokes out of the corners.
layer-rule {
    match namespace="^waybar$"
    background-effect { blur true; }
    geometry-corner-radius 12
}
// The Quickshell bar; its tooltips and tray menus are popups of it.
layer-rule {
    match namespace="^bar$"
    background-effect { blur true; }
    geometry-corner-radius 12
    popups {
        geometry-corner-radius 10
        background-effect { blur true; }
    }
}
layer-rule {
    match namespace="^swaync-control-center$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 12
}
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 14
}
layer-rule {
    match namespace="^nowplaying$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 14
}
layer-rule {
    match namespace="^powerpanel$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 14
}
layer-rule {
    match namespace="^swayosd$"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 14
}
