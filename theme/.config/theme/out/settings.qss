/* GENERATED by `theme apply` from ~/.config/theme/templates/settings.qss (rose-pine dark) - edit that or the theme.
   Stylesheet of niri-settings (Qt). Colours are #aarrggbb (the |qml filter); the app reloads this file when it changes. */
* { font-family: "Inter"; font-size: 13px; color: #ffe0def4; }
#root { background: #e0191724; }
#side { background: #09e0def4; border-right: 1px solid #1ae0def4; }
#brand { font-size: 17px; font-weight: 600; color: #ffe0def4; padding: 0 10px 8px 10px; }
#nav { color: #ffc0bdd8; background: transparent; border: none; outline: 0; }
#nav::item { padding: 9px 10px; margin: 1px 0; border-radius: 9px; color: #ffc0bdd8; }
#nav::item:hover { background: #0de0def4; }
#nav::item:selected { background: #1ae0def4; color: #ffe0def4; }
#status { color: #ffb7b4cf; font-size: 12px; padding: 0 10px; }

QScrollArea, #pageInner { background: transparent; border: none; }
#pageTitle { font-size: 22px; font-weight: 600; color: #ffe0def4; padding-bottom: 4px; }
#sectionTitle { font-weight: 600; color: #ffc0bdd8; padding-top: 12px; }
#card { background: #0fe0def4; border: 1px solid #1ae0def4; border-radius: 16px; }
#row { background: transparent; }
#sep { background: #1ae0def4; border: none; margin: 0 12px; }
#rowTitle { color: #ffe0def4; }
#rowSub { color: #ffb7b4cf; font-size: 12px; }

QPushButton { background: #14e0def4; border: none; border-radius: 9px; padding: 6px 16px; color: #ffe0def4; }
QPushButton:hover { background: #21e0def4; }
QPushButton:pressed { background: #29e0def4; }
QPushButton#step { padding: 0; font-size: 16px; }
QToolButton#reset { background: transparent; border: none; border-radius: 9px; padding: 4px 10px; color: #ffb7b4cf; }
QToolButton#reset:hover { background: #14e0def4; color: #ffe0def4; }

QLineEdit, QComboBox, QAbstractSpinBox {
    background: #14e0def4; border: 1px solid transparent; border-radius: 9px;
    padding: 5px 10px; min-height: 18px; color: #ffe0def4;
    selection-background-color: #33ebbcba; selection-color: #ffe0def4;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { background: #21e0def4; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border: 1px solid #99ebbcba; }
QComboBox { combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(~/.config/theme/out/icons/settings-chevron.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #fa1c1a29; border: 1px solid #1ae0def4; border-radius: 9px;
    padding: 4px; outline: 0;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; min-height: 20px; border-radius: 9px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected { background: #1ae0def4; color: #ffe0def4; }

/* like the shell's Slider.qml: soft 6 px track, fill in the title colour, round knob that grows under the pointer */
QSlider { min-height: 22px; }
QSlider::groove:horizontal { height: 6px; background: #29e0def4; border-radius: 3px; }
QSlider::sub-page:horizontal { height: 6px; background: #ffc0bdd8; border-radius: 3px; }
QSlider::handle:horizontal { background: #ffe0def4; width: 16px; height: 16px; margin: -5px 0; border-radius: 8px; }
QSlider::handle:horizontal:hover, QSlider::handle:horizontal:pressed { width: 18px; height: 18px; margin: -6px -1px; border-radius: 9px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #29e0def4; border-radius: 3px; min-height: 30px; margin: 0 2px; }
QScrollBar::handle:vertical:hover { background: #21e0def4; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QListWidget#walls { background: transparent; border: none; outline: 0; }
Walls { qproperty-thumbRadius: 9; }
QListWidget#walls::item { border: 2px solid transparent; border-radius: 16px; padding: 2px; }
QListWidget#walls::item:hover { background: #1ae0def4; }
QListWidget#walls::item:selected { border: 2px solid #ffebbcba; background: transparent; }

QTreeWidget#keys { background: transparent; border: none; outline: 0; }
QTreeWidget#keys::item { padding: 3px 6px; border: none; }
KeyList { qproperty-capColor: #1ae0def4; qproperty-capText: #ffe0def4; qproperty-capRadius: 9; }

QToolTip { background: #fa1c1a29; color: #ffe0def4; border: 1px solid #1ae0def4; padding: 4px 8px; }
QMenu { background: #fa1c1a29; border: 1px solid #1ae0def4; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 9px; }
QMenu::item:selected { background: #1ae0def4; }

/* the shell's Switch.qml: filled when on, knob in the title colour when off */
Switch { qproperty-onColor: #ffebbcba; qproperty-offColor: #29e0def4; qproperty-knobColor: #ffc0bdd8; qproperty-knobOnColor: #ff191724; }
ThemeCard { qproperty-accent: #ffebbcba; qproperty-border: #4ce0def4; qproperty-radius: 16; qproperty-innerRadius: 9; }
