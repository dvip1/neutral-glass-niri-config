/* GENERATED by `theme apply` from ~/.config/theme/templates/settings.qss (rose-pine light) - edit that or the theme.
   Stylesheet of niri-settings (Qt). Colours are #aarrggbb (the |qml filter); the app reloads this file when it changes. */
* { font-family: "Inter"; font-size: 13px; color: #ff575279; }
#root { background: #e0faf4ed; }
#side { background: #09575279; border-right: 1px solid #1a575279; }
#brand { font-size: 17px; font-weight: 600; color: #ff575279; padding: 0 10px 8px 10px; }
#nav { color: #ff797593; background: transparent; border: none; outline: 0; }
#nav::item { padding: 9px 10px; margin: 1px 0; border-radius: 9px; color: #ff797593; }
#nav::item:hover { background: #0d575279; }
#nav::item:selected { background: #1a575279; color: #ff575279; }
#status { color: #ff7b7691; font-size: 12px; padding: 0 10px; }

QScrollArea, #pageInner { background: transparent; border: none; }
#pageTitle { font-size: 22px; font-weight: 600; color: #ff575279; padding-bottom: 4px; }
#sectionTitle { font-weight: 600; color: #ff797593; padding-top: 12px; }
#card { background: #0f575279; border: 1px solid #1a575279; border-radius: 16px; }
#row { background: transparent; }
#sep { background: #1a575279; border: none; margin: 0 12px; }
#rowTitle { color: #ff575279; }
#rowSub { color: #ff7b7691; font-size: 12px; }

QPushButton { background: #14575279; border: none; border-radius: 9px; padding: 6px 16px; color: #ff575279; }
QPushButton:hover { background: #21575279; }
QPushButton:pressed { background: #29575279; }
QPushButton#step { padding: 0; font-size: 16px; }
QToolButton#reset { background: transparent; border: none; border-radius: 9px; padding: 4px 10px; color: #ff7b7691; }
QToolButton#reset:hover { background: #14575279; color: #ff575279; }

QLineEdit, QComboBox, QAbstractSpinBox {
    background: #14575279; border: 1px solid transparent; border-radius: 9px;
    padding: 5px 10px; min-height: 18px; color: #ff575279;
    selection-background-color: #33d7827e; selection-color: #ff575279;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { background: #21575279; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border: 1px solid #99d7827e; }
QComboBox { combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(~/.config/theme/out/icons/settings-chevron.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #fafcf7f0; border: 1px solid #1a575279; border-radius: 9px;
    padding: 4px; outline: 0;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; min-height: 20px; border-radius: 9px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected { background: #1a575279; color: #ff575279; }

/* like the shell's Slider.qml: soft 6 px track, fill in the title colour, round knob that grows under the pointer */
QSlider { min-height: 22px; }
QSlider::groove:horizontal { height: 6px; background: #29575279; border-radius: 3px; }
QSlider::sub-page:horizontal { height: 6px; background: #ff797593; border-radius: 3px; }
QSlider::handle:horizontal { background: #ff575279; width: 16px; height: 16px; margin: -5px 0; border-radius: 8px; }
QSlider::handle:horizontal:hover, QSlider::handle:horizontal:pressed { width: 18px; height: 18px; margin: -6px -1px; border-radius: 9px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #29575279; border-radius: 3px; min-height: 30px; margin: 0 2px; }
QScrollBar::handle:vertical:hover { background: #21575279; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QListWidget#walls { background: transparent; border: none; outline: 0; }
Walls { qproperty-thumbRadius: 9; }
QListWidget#walls::item { border: 2px solid transparent; border-radius: 16px; padding: 2px; }
QListWidget#walls::item:hover { background: #1a575279; }
QListWidget#walls::item:selected { border: 2px solid #ffd7827e; background: transparent; }

QTreeWidget#keys { background: transparent; border: none; outline: 0; }
QTreeWidget#keys::item { padding: 3px 6px; border: none; }
KeyList { qproperty-capColor: #1a575279; qproperty-capText: #ff575279; qproperty-capRadius: 9; }

QToolTip { background: #fafcf7f0; color: #ff575279; border: 1px solid #1a575279; padding: 4px 8px; }
QMenu { background: #fafcf7f0; border: 1px solid #1a575279; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 9px; }
QMenu::item:selected { background: #1a575279; }

/* the shell's Switch.qml: filled when on, knob in the title colour when off */
Switch { qproperty-onColor: #ffd7827e; qproperty-offColor: #29575279; qproperty-knobColor: #ff797593; qproperty-knobOnColor: #fffaf4ed; }
ThemeCard { qproperty-accent: #ffd7827e; qproperty-border: #4c575279; qproperty-radius: 16; qproperty-innerRadius: 9; }
