/* GENERATED by `theme apply` from ~/.config/theme/templates/settings.qss (gruvbox dark) - edit that or the theme.
   Stylesheet of niri-settings (Qt). Colours are #aarrggbb (the |qml filter); the app reloads this file when it changes. */
* { font-family: "JetBrains Mono"; font-size: 12.5px; color: #ffebdbb2; }
#root { background: #fa282828; }
#side { background: #08ebdbb2; border-right: 1px solid #14ebdbb2; }
#brand { font-size: 17px; font-weight: 600; color: #ffebdbb2; padding: 0 10px 8px 10px; }
#nav { color: #ffd5c4a1; background: transparent; border: none; outline: 0; }
#nav::item { padding: 9px 10px; margin: 1px 0; border-radius: 4px; color: #ffd5c4a1; }
#nav::item:hover { background: #14ebdbb2; }
#nav::item:selected { background: #33fabd2f; color: #ffebdbb2; }
#status { color: #ff928374; font-size: 12px; padding: 0 10px; }

QScrollArea, #pageInner { background: transparent; border: none; }
#pageTitle { font-size: 22px; font-weight: 600; color: #ffebdbb2; padding-bottom: 4px; }
#sectionTitle { font-weight: 600; color: #ff928374; padding-top: 12px; }
#card { background: #0bebdbb2; border: 1px solid #14ebdbb2; border-radius: 6px; }
#row { background: transparent; }
#sep { background: #14ebdbb2; border: none; margin: 0 12px; }
#rowTitle { color: #ffebdbb2; }
#rowSub { color: #ff928374; font-size: 12px; }

QPushButton { background: #14ebdbb2; border: none; border-radius: 4px; padding: 6px 16px; color: #ffebdbb2; }
QPushButton:hover { background: #21ebdbb2; }
QPushButton:pressed { background: #33fabd2f; }
QPushButton#step { padding: 0; font-size: 16px; }
QToolButton#reset { background: transparent; border: none; border-radius: 4px; padding: 4px 10px; color: #ff928374; }
QToolButton#reset:hover { background: #14ebdbb2; color: #ffebdbb2; }

QLineEdit, QComboBox, QAbstractSpinBox {
    background: #14ebdbb2; border: 1px solid transparent; border-radius: 4px;
    padding: 5px 10px; min-height: 18px; color: #ffebdbb2;
    selection-background-color: #33fabd2f; selection-color: #ffebdbb2;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { background: #21ebdbb2; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border: 1px solid #99fabd2f; }
QComboBox { combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(~/.config/theme/out/icons/settings-chevron.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #fa2d2c2c; border: 1px solid #14ebdbb2; border-radius: 4px;
    padding: 4px; outline: 0;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; min-height: 20px; border-radius: 4px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected { background: #33fabd2f; color: #ffebdbb2; }

QSlider::groove:horizontal { height: 4px; background: #33ebdbb2; border-radius: 2px; }
QSlider::sub-page:horizontal { height: 4px; background: #fffabd2f; border-radius: 2px; }
QSlider::handle:horizontal { background: #ffebdbb2; width: 16px; height: 16px; margin: -6px 0; border-radius: 8px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #33ebdbb2; border-radius: 3px; min-height: 30px; margin: 0 2px; }
QScrollBar::handle:vertical:hover { background: #21ebdbb2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QListWidget#walls { background: transparent; border: none; outline: 0; }
QListWidget#walls::item { border: 2px solid transparent; border-radius: 10px; padding: 2px; }
QListWidget#walls::item:hover { background: #14ebdbb2; }
QListWidget#walls::item:selected { border: 2px solid #fffabd2f; background: transparent; }

QTreeWidget#keys { background: transparent; border: none; outline: 0; }
QTreeWidget#keys::item { padding: 4px 6px; border: none; }
QTreeWidget#keys::item:hover { background: #14ebdbb2; }

QToolTip { background: #fa2d2c2c; color: #ffebdbb2; border: 1px solid #14ebdbb2; padding: 4px 8px; }
QMenu { background: #fa2d2c2c; border: 1px solid #14ebdbb2; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background: #33fabd2f; }

Switch { qproperty-onColor: #fffabd2f; qproperty-offColor: #33ebdbb2; qproperty-knobColor: #ffffffff; qproperty-knobOnColor: #cc000000; }
ThemeCard { qproperty-accent: #fffabd2f; qproperty-border: #4cebdbb2; }
