# GENERATED by `theme apply` from ~/.config/theme/templates/icon-theme.index ({{theme}} {{mode}}).
# Icon theme "Niri": Adwaita with folders in the theme's colour (templates/folders/). Used under niri only.
[Icon Theme]
Name=Niri
Comment=Adwaita with themed folders
