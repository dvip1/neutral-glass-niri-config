/* GENERATED by `theme apply` from ~/.config/theme/templates/settings.qss ({{theme}} {{mode}}) - edit that or the theme.
   Stylesheet of niri-settings (Qt). Colours are #aarrggbb (the |qml filter); the app reloads this file when it changes. */
* { font-family: "{{font}}"; font-size: {{font_size}}px; color: {{fg|qml}}; }
#root { background: {{set_bg|qml}}; }
#side { background: {{set_side|qml}}; border-right: 1px solid {{set_line|qml}}; }
#brand { font-size: 17px; font-weight: 600; color: {{fg_strong|qml}}; padding: 0 10px 8px 10px; }
#nav { color: {{fg_title|qml}}; background: transparent; border: none; outline: 0; }
#nav::item { padding: 9px 10px; margin: 1px 0; border-radius: {{radius_small}}px; color: {{fg_title|qml}}; }
#nav::item:hover { background: {{pill_bg|qml}}; }
#nav::item:selected { background: {{pill_hover|qml}}; color: {{fg_strong|qml}}; }
#status { color: {{set_muted|qml}}; font-size: 12px; padding: 0 10px; }

QScrollArea, #pageInner { background: transparent; border: none; }
#pageTitle { font-size: 22px; font-weight: 600; color: {{fg_strong|qml}}; padding-bottom: 4px; }
#sectionTitle { font-weight: 600; color: {{fg_title|qml}}; padding-top: 12px; }
#card { background: {{set_card|qml}}; border: 1px solid {{set_line|qml}}; border-radius: {{radius}}px; }
#row { background: transparent; }
#sep { background: {{set_line|qml}}; border: none; margin: 0 12px; }
#rowTitle { color: {{fg_strong|qml}}; }
#rowSub { color: {{set_muted|qml}}; font-size: 12px; }

QPushButton { background: {{set_field|qml}}; border: none; border-radius: {{radius_small}}px; padding: 6px 16px; color: {{fg_strong|qml}}; }
QPushButton:hover { background: {{set_field_hover|qml}}; }
QPushButton:pressed { background: {{pill_press|qml}}; }
QPushButton#step { padding: 0; font-size: 16px; }
QToolButton#reset { background: transparent; border: none; border-radius: {{radius_small}}px; padding: 4px 10px; color: {{set_muted|qml}}; }
QToolButton#reset:hover { background: {{set_field|qml}}; color: {{fg_strong|qml}}; }

QLineEdit, QComboBox, QAbstractSpinBox {
    background: {{set_field|qml}}; border: 1px solid transparent; border-radius: {{radius_small}}px;
    padding: 5px 10px; min-height: 18px; color: {{fg_strong|qml}};
    selection-background-color: {{set_sel|qml}}; selection-color: {{fg_strong|qml}};
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { background: {{set_field_hover|qml}}; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border: 1px solid {{set_focus|qml}}; }
QComboBox { combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(~/.config/theme/out/icons/settings-chevron.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: {{set_popup|qml}}; border: 1px solid {{set_line|qml}}; border-radius: {{radius_small}}px;
    padding: 4px; outline: 0;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; min-height: 20px; border-radius: {{radius_small}}px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected { background: {{pill_hover|qml}}; color: {{fg_strong|qml}}; }

/* like the shell's Slider.qml: soft 6 px track, fill in the title colour, round knob that grows under the pointer */
QSlider { min-height: 22px; }
QSlider::groove:horizontal { height: 6px; background: {{set_track|qml}}; border-radius: 3px; }
QSlider::sub-page:horizontal { height: 6px; background: {{fg_title|qml}}; border-radius: 3px; }
QSlider::handle:horizontal { background: {{fg_strong|qml}}; width: 16px; height: 16px; margin: -5px 0; border-radius: 8px; }
QSlider::handle:horizontal:hover, QSlider::handle:horizontal:pressed { width: 18px; height: 18px; margin: -6px -1px; border-radius: 9px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: {{set_track|qml}}; border-radius: 3px; min-height: 30px; margin: 0 2px; }
QScrollBar::handle:vertical:hover { background: {{set_field_hover|qml}}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QListWidget#walls { background: transparent; border: none; outline: 0; }
Walls { qproperty-thumbRadius: {{radius_small}}; }
QListWidget#walls::item { border: 2px solid transparent; border-radius: {{radius}}px; padding: 2px; }
QListWidget#walls::item:hover { background: {{pill_hover|qml}}; }
QListWidget#walls::item:selected { border: 2px solid {{ws_pill|qml}}; background: transparent; }

QTreeWidget#keys { background: transparent; border: none; outline: 0; }
QTreeWidget#keys::item { padding: 3px 6px; border: none; }
KeyList { qproperty-capColor: {{pill_hover|qml}}; qproperty-capText: {{fg_strong|qml}}; qproperty-capRadius: {{radius_small}}; }

QToolTip { background: {{set_popup|qml}}; color: {{fg_strong|qml}}; border: 1px solid {{set_line|qml}}; padding: 4px 8px; }
QMenu { background: {{set_popup|qml}}; border: 1px solid {{set_line|qml}}; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: {{radius_small}}px; }
QMenu::item:selected { background: {{pill_hover|qml}}; }

/* the shell's Switch.qml: filled when on, knob in the title colour when off */
Switch { qproperty-onColor: {{ws_pill|qml}}; qproperty-offColor: {{set_track|qml}}; qproperty-knobColor: {{fg_title|qml}}; qproperty-knobOnColor: {{bg|qml}}; }
ThemeCard { qproperty-accent: {{ws_pill|qml}}; qproperty-border: {{set_line_strong|qml}}; qproperty-radius: {{radius}}; qproperty-innerRadius: {{radius_small}}; }
